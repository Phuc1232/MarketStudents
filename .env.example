# Database Cấu trúc: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/unimarket_db

# Security & JWT Token
SECRET_KEY=your_super_secret_key_here_generate_with_openssl
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# --- REDIS CONFIGURATION (OTP & Session Cache - Zero PostgreSQL Table Writes) ---
# Để trống để tự động dùng InMemory fallback (phù hợp máy local chưa cài Redis)
# Khi lên AWS/Production, điền: redis://:your_redis_password@redis-host:6379/0
REDIS_URL=

# --- EMAIL / SMTP SERVICE CONFIGURATION ---
# Cách 1: Khi test ở Local bằng Gmail:
#   MAIL_SERVER=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your_gmail@gmail.com
#   MAIL_PASSWORD=your_16_char_google_app_password
#   MAIL_FROM=your_gmail@gmail.com
#
# Cách 2: Khi deploy lên AWS dùng AWS SES (Chỉ đổi .env, KHÔNG sửa code):
#   MAIL_SERVER=email-smtp.ap-southeast-1.amazonaws.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your_aws_ses_smtp_username
#   MAIL_PASSWORD=your_aws_ses_smtp_password
#   MAIL_FROM=noreply@yourdomain.edu.vn
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@unimarket.vn
MAIL_FROM_NAME=UniMarket
